
policy_module(local, 1.0)

require {
	type sshd_t;
	type root_t;
	type fs_t;
	type systemd_tmpfiles_t;
	type usr_t;
	type bin_t;
	type initrc_t;
	type fixed_disk_device_t;
	type getty_t;
	type mount_runtime_t;
	type system_dbusd_t;
	type systemd_journal_init_t;
	type fsadm_exec_t;
	type lib_t;
	type systemd_networkd_t;
	type init_exec_t;
	type udev_t;
     type init_runtime_t;
     type mount_t;
     type tmp_t;
	type xdg_data_t;
	type var_log_t;
	type auditd_log_t;
	type auditd_etc_t;
	type sudo_exec_t;
	type systemd_journal_t;
	type var_t;
	type tmpfs_t;
	type loop_control_device_t;
	type shell_exec_t;
	type etc_runtime_t;
	type var_lib_t;
	type kmod_t;
	type xdg_cache_t;
    type home_root_t;
    type user_home_dir_t;
	type mount_exec_t;
	type systemd_runtime_notify_t;
	class dir { add_name create search setattr watch write };
	class lnk_file { create getattr read };
	class file { append create execute execute_no_trans getattr ioctl map open read setattr write };
	class process execmem;
	class capability { dac_override net_admin };
	class capability2 checkpoint_restore;
	class sock_file getattr;
	class chr_file getattr;
	class blk_file { getattr ioctl open read };
}

#============= getty_t ==============
allow getty_t self:capability2 checkpoint_restore;

#============= initrc_t ==============

#!!!! This avc can be allowed using one of the these booleans:
#     allow_execmem, allow_execstack
allow initrc_t self:process execmem;

#============= kmod_t ==============
allow kmod_t self:capability net_admin;

#============= sshd_t ==============
allow sshd_t fixed_disk_device_t:blk_file { getattr ioctl open read };
allow sshd_t fsadm_exec_t:file { execute execute_no_trans getattr map open read };
allow sshd_t lib_t:file execute_no_trans;
allow sshd_t loop_control_device_t:chr_file getattr;
allow sshd_t mount_exec_t:file { execute execute_no_trans getattr map open read };
allow sshd_t mount_runtime_t:dir search;
allow sshd_t mount_runtime_t:file { getattr open read };

#!!!! This avc can be allowed using the boolean 'allow_polyinstantiation'
allow sshd_t self:capability dac_override;
allow sshd_t systemd_runtime_notify_t:sock_file getattr;
allow sshd_t usr_t:file { execute execute_no_trans };
allow sshd_t var_lib_t:file { getattr open read setattr write };
allow sshd_t var_log_t:dir { add_name write };
allow sshd_t var_log_t:file { append create getattr ioctl open };
allow sshd_t var_t:file { getattr open read };

#!!!! This avc can be allowed using the boolean 'allow_polyinstantiation'
allow sshd_t xdg_cache_t:dir search;
allow sshd_t xdg_cache_t:file getattr;

#!!!! This avc can be allowed using the boolean 'allow_polyinstantiation'
allow sshd_t xdg_data_t:dir search;

#============= system_dbusd_t ==============
allow system_dbusd_t var_lib_t:dir watch;

#============= systemd_journal_init_t ==============
allow systemd_journal_init_t etc_runtime_t:file { open read };
allow systemd_journal_init_t systemd_journal_t:file map;
allow systemd_journal_init_t var_log_t:dir search;
allow systemd_journal_init_t var_log_t:file { getattr ioctl write };

#============= systemd_networkd_t ==============
allow systemd_networkd_t tmpfs_t:file write;

#============= systemd_tmpfiles_t ==============

#!!!! This avc can be allowed using the boolean 'systemd_tmpfiles_manage_all'
allow systemd_tmpfiles_t bin_t:dir search;
allow systemd_tmpfiles_t bin_t:lnk_file read;

#!!!! This avc can be allowed using the boolean 'systemd_tmpfiles_manage_all'
allow systemd_tmpfiles_t init_exec_t:file { getattr open read };

#!!!! This avc can be allowed using the boolean 'systemd_tmpfiles_manage_all'
allow systemd_tmpfiles_t shell_exec_t:file { getattr open read };

#!!!! This avc can be allowed using the boolean 'systemd_tmpfiles_manage_all'
allow systemd_tmpfiles_t tmpfs_t:dir { add_name create setattr write };

#!!!! This avc can be allowed using the boolean 'systemd_tmpfiles_manage_all'
allow systemd_tmpfiles_t tmpfs_t:file { create getattr ioctl open setattr write };
allow systemd_tmpfiles_t tmpfs_t:lnk_file { create getattr read };

#============= udev_t ==============
allow udev_t lib_t:file execute_no_trans;
allow udev_t var_lib_t:file getattr;
allow udev_t init_runtime_t:file getattr;
allow mount_t tmp_t:file write;

# SEbuntu AI application identities, domains, and least-privilege file access.
########################################
# Application roles and process domains
########################################

role assistant_r;
type assistant_t;
type assistant_exec_t;
role assistant_r types assistant_t;
init_daemon_domain(assistant_t, assistant_exec_t)

role assistant_cmd_monitoring_r;
type assistant_cmd_monitoring_t;
type assistant_cmd_monitoring_exec_t;
role assistant_cmd_monitoring_r types assistant_cmd_monitoring_t;
init_daemon_domain(assistant_cmd_monitoring_t, assistant_cmd_monitoring_exec_t)

# Sudo may enter this read-only domain only for the fixed, sudoers-allowlisted
# ausearch query. The command-monitoring domain itself cannot read audit logs.
type assistant_cmd_audit_reader_t;
domain_type(assistant_cmd_audit_reader_t)
role assistant_cmd_audit_reader_r;
role assistant_cmd_audit_reader_r types assistant_cmd_audit_reader_t;

role assistant_web_monitoring_r;
type assistant_web_monitoring_t;
type assistant_web_monitoring_exec_t;
role assistant_web_monitoring_r types assistant_web_monitoring_t;
init_daemon_domain(assistant_web_monitoring_t, assistant_web_monitoring_exec_t)

role system_resources_monitoring_r;
type system_resources_monitoring_t;
type system_resources_monitoring_exec_t;
role system_resources_monitoring_r types system_resources_monitoring_t;
init_daemon_domain(system_resources_monitoring_t, system_resources_monitoring_exec_t)

role tux_r;
type tux_t;
type tux_exec_t;
role tux_r types tux_t;
init_daemon_domain(tux_t, tux_exec_t)

# Dedicated destination type for the local Ollama inference service.
type ollama_port_t;
corenet_port(ollama_port_t)

# System services enter each distinct SELinux identity and role with its domain.
allow system_r assistant_r;
allow system_r assistant_cmd_monitoring_r;
allow system_r assistant_web_monitoring_r;
allow system_r system_resources_monitoring_r;
allow system_r tux_r;
role_transition system_r assistant_exec_t assistant_r;
role_transition system_r assistant_cmd_monitoring_exec_t assistant_cmd_monitoring_r;
role_transition system_r assistant_web_monitoring_exec_t assistant_web_monitoring_r;
role_transition system_r system_resources_monitoring_exec_t system_resources_monitoring_r;
role_transition system_r tux_exec_t tux_r;

########################################
# Application and private data types
########################################

type ai_code_root_t;
files_type(ai_code_root_t)

type ai_state_path_t;
files_type(ai_state_path_t)

type ai_memory_root_t;
files_type(ai_memory_root_t)

type ai_monitoring_root_t;
files_type(ai_monitoring_root_t)

type ai_human_private_t;
files_type(ai_human_private_t)

type assistant_code_t;
files_type(assistant_code_t)
type assistant_python_exec_t;
files_type(assistant_python_exec_t)
type assistant_memory_t;
files_type(assistant_memory_t)

type assistant_reports_code_t;
files_type(assistant_reports_code_t)

type assistant_cmd_monitoring_code_t;
files_type(assistant_cmd_monitoring_code_t)
type assistant_cmd_monitoring_memory_t;
files_type(assistant_cmd_monitoring_memory_t)
type assistant_cmd_monitoring_work_t;
files_type(assistant_cmd_monitoring_work_t)

type assistant_web_monitoring_code_t;
files_type(assistant_web_monitoring_code_t)
type assistant_web_monitoring_memory_t;
files_type(assistant_web_monitoring_memory_t)
type assistant_web_monitoring_work_t;
files_type(assistant_web_monitoring_work_t)
type assistant_web_monitoring_runtime_t;
files_type(assistant_web_monitoring_runtime_t)
type assistant_web_monitoring_psql_exec_t;
files_type(assistant_web_monitoring_psql_exec_t)

type system_resources_monitoring_code_t;
files_type(system_resources_monitoring_code_t)
type system_resources_monitoring_memory_t;
files_type(system_resources_monitoring_memory_t)

type tux_code_t;
files_type(tux_code_t)
type tux_memory_t;
files_type(tux_memory_t)
type tux_state_t;
files_type(tux_state_t)

########################################
# Shared path traversal; no directory listing
########################################

allow { assistant_t assistant_cmd_monitoring_t assistant_web_monitoring_t system_resources_monitoring_t tux_t }
    ai_code_root_t:dir search;

allow { assistant_t assistant_cmd_monitoring_t assistant_web_monitoring_t system_resources_monitoring_t tux_t }
    ai_state_path_t:dir search;

allow { assistant_t assistant_cmd_monitoring_t assistant_web_monitoring_t system_resources_monitoring_t tux_t }
    ai_memory_root_t:dir search;

allow { assistant_cmd_monitoring_t assistant_web_monitoring_t }
    ai_monitoring_root_t:dir search;

########################################
# Read-only application code access
########################################

list_dirs_pattern(assistant_t, assistant_code_t, assistant_code_t)
read_files_pattern(assistant_t, assistant_code_t, assistant_code_t)
allow assistant_t assistant_python_exec_t:file { execute execute_no_trans getattr map open read };

list_dirs_pattern(assistant_cmd_monitoring_t, assistant_cmd_monitoring_code_t, assistant_cmd_monitoring_code_t)
read_files_pattern(assistant_cmd_monitoring_t, assistant_cmd_monitoring_code_t, assistant_cmd_monitoring_code_t)

list_dirs_pattern(assistant_web_monitoring_t, assistant_web_monitoring_code_t, assistant_web_monitoring_code_t)
read_files_pattern(assistant_web_monitoring_t, assistant_web_monitoring_code_t, assistant_web_monitoring_code_t)

list_dirs_pattern(system_resources_monitoring_t, system_resources_monitoring_code_t, system_resources_monitoring_code_t)
read_files_pattern(system_resources_monitoring_t, system_resources_monitoring_code_t, system_resources_monitoring_code_t)

list_dirs_pattern(tux_t, tux_code_t, tux_code_t)
read_files_pattern(tux_t, tux_code_t, tux_code_t)

########################################
# Per-agent short-term memory
########################################

manage_dirs_pattern(assistant_t, assistant_memory_t, assistant_memory_t)
manage_files_pattern(assistant_t, assistant_memory_t, assistant_memory_t)

manage_dirs_pattern(assistant_cmd_monitoring_t, assistant_cmd_monitoring_memory_t, assistant_cmd_monitoring_memory_t)
manage_files_pattern(assistant_cmd_monitoring_t, assistant_cmd_monitoring_memory_t, assistant_cmd_monitoring_memory_t)

manage_dirs_pattern(assistant_web_monitoring_t, assistant_web_monitoring_memory_t, assistant_web_monitoring_memory_t)
manage_files_pattern(assistant_web_monitoring_t, assistant_web_monitoring_memory_t, assistant_web_monitoring_memory_t)

manage_dirs_pattern(system_resources_monitoring_t, system_resources_monitoring_memory_t, system_resources_monitoring_memory_t)
manage_files_pattern(system_resources_monitoring_t, system_resources_monitoring_memory_t, system_resources_monitoring_memory_t)

manage_dirs_pattern(tux_t, tux_memory_t, tux_memory_t)
manage_files_pattern(tux_t, tux_memory_t, tux_memory_t)
manage_dirs_pattern(tux_t, tux_state_t, tux_state_t)
manage_files_pattern(tux_t, tux_state_t, tux_state_t)

########################################
# Monitoring agents' separate work areas
########################################

manage_dirs_pattern(assistant_cmd_monitoring_t, assistant_cmd_monitoring_work_t, assistant_cmd_monitoring_work_t)
manage_files_pattern(assistant_cmd_monitoring_t, assistant_cmd_monitoring_work_t, assistant_cmd_monitoring_work_t)

manage_dirs_pattern(assistant_web_monitoring_t, assistant_web_monitoring_work_t, assistant_web_monitoring_work_t)
manage_files_pattern(assistant_web_monitoring_t, assistant_web_monitoring_work_t, assistant_web_monitoring_work_t)

# Assistant can submit events to the monitoring agent over one datagram socket.
# It has no read access to the runtime directory or the monitoring data files.
allow assistant_t assistant_web_monitoring_runtime_t:dir search;
allow assistant_t assistant_web_monitoring_runtime_t:sock_file write;
allow assistant_t assistant_web_monitoring_t:unix_dgram_socket sendto;
allow mitmproxy_t assistant_web_monitoring_runtime_t:dir search;
allow mitmproxy_t assistant_web_monitoring_runtime_t:sock_file write;
allow mitmproxy_t assistant_web_monitoring_t:unix_dgram_socket sendto;
manage_dirs_pattern(assistant_web_monitoring_t, assistant_web_monitoring_runtime_t, assistant_web_monitoring_runtime_t)
manage_sock_files_pattern(assistant_web_monitoring_t, assistant_web_monitoring_runtime_t, assistant_web_monitoring_runtime_t)
allow assistant_web_monitoring_t self:unix_dgram_socket { create bind getattr read recvfrom setopt };
allow assistant_web_monitoring_t self:tcp_socket create_stream_socket_perms;
allow assistant_web_monitoring_t ollama_port_t:tcp_socket name_connect;
allow assistant_web_monitoring_t assistant_web_monitoring_psql_exec_t:file { execute execute_no_trans getattr map open read };
allow assistant_web_monitoring_t bin_t:dir search;
libs_use_ld_so(assistant_web_monitoring_t)
libs_use_shared_libs(assistant_web_monitoring_t)
miscfiles_read_localization(assistant_web_monitoring_t)
files_read_etc_files(assistant_web_monitoring_t)
postgresql_stream_connect(assistant_web_monitoring_t)
allow assistant_cmd_monitoring_t assistant_web_monitoring_psql_exec_t:file { execute execute_no_trans getattr map open read };
allow assistant_cmd_monitoring_t sudo_exec_t:file { execute execute_no_trans getattr map open read };
allow assistant_cmd_monitoring_t bin_t:dir search;
libs_use_ld_so(assistant_cmd_monitoring_t)
libs_use_shared_libs(assistant_cmd_monitoring_t)
files_read_etc_files(assistant_cmd_monitoring_t)
postgresql_stream_connect(assistant_cmd_monitoring_t)

allow system_resources_monitoring_t assistant_web_monitoring_psql_exec_t:file { execute execute_no_trans getattr map open read };
allow system_resources_monitoring_t bin_t:dir search;
allow system_resources_monitoring_t bin_t:file { execute execute_no_trans getattr map open read };
allow system_resources_monitoring_t bin_t:lnk_file read;
allow system_resources_monitoring_t root_t:dir { getattr search };
allow system_resources_monitoring_t fs_t:filesystem getattr;
allow system_resources_monitoring_t self:fifo_file { getattr ioctl read write };
kernel_read_system_state(system_resources_monitoring_t)
libs_use_ld_so(system_resources_monitoring_t)
libs_use_shared_libs(system_resources_monitoring_t)
miscfiles_read_localization(system_resources_monitoring_t)
files_read_etc_files(system_resources_monitoring_t)
postgresql_stream_connect(system_resources_monitoring_t)

allow assistant_cmd_audit_reader_t auditd_log_t:dir { getattr open read search };
allow assistant_cmd_audit_reader_t auditd_log_t:file { getattr open read };
allow assistant_cmd_audit_reader_t auditd_etc_t:file { getattr open read };
allow assistant_cmd_audit_reader_t bin_t:dir search;
allow assistant_cmd_audit_reader_t bin_t:file { execute execute_no_trans getattr map open read };
allow assistant_cmd_audit_reader_t self:capability dac_override;
libs_use_ld_so(assistant_cmd_audit_reader_t)
libs_use_shared_libs(assistant_cmd_audit_reader_t)
allow mitmproxy_t self:unix_dgram_socket { create write getattr setopt };
allow assistant_web_monitoring_t { home_root_t user_home_dir_t xdg_data_t ai_state_path_t ai_monitoring_root_t }:dir { getattr search };

########################################
# Local AI outbound web proxy
########################################

role mitmproxy_r;
type mitmproxy_t;
type mitmproxy_exec_t;
role mitmproxy_r types mitmproxy_t;
allow system_r mitmproxy_r;
role_transition system_r mitmproxy_exec_t mitmproxy_r;
init_daemon_domain(mitmproxy_t, mitmproxy_exec_t)

type mitmproxy_runtime_t;
files_type(mitmproxy_runtime_t)
type mitmproxy_code_t;
files_type(mitmproxy_code_t)
type mitmproxy_config_t;
files_type(mitmproxy_config_t)
type mitmproxy_state_t;
files_type(mitmproxy_state_t)

list_dirs_pattern(mitmproxy_t, mitmproxy_runtime_t, mitmproxy_runtime_t)
read_files_pattern(mitmproxy_t, mitmproxy_runtime_t, mitmproxy_runtime_t)
list_dirs_pattern(mitmproxy_t, mitmproxy_code_t, mitmproxy_code_t)
read_files_pattern(mitmproxy_t, mitmproxy_code_t, mitmproxy_code_t)
list_dirs_pattern(mitmproxy_t, mitmproxy_config_t, mitmproxy_config_t)
read_files_pattern(mitmproxy_t, mitmproxy_config_t, mitmproxy_config_t)
manage_dirs_pattern(mitmproxy_t, mitmproxy_state_t, mitmproxy_state_t)
manage_files_pattern(mitmproxy_t, mitmproxy_state_t, mitmproxy_state_t)

allow mitmproxy_t self:tcp_socket create_stream_socket_perms;
allow mitmproxy_t self:udp_socket create_socket_perms;
corenet_tcp_bind_http_cache_port(mitmproxy_t)
corenet_tcp_connect_http_port(mitmproxy_t)
sysnet_dns_name_resolve(mitmproxy_t)

# Runtime access needed by the proxy's system Python and fixed virtualenv.
corecmd_exec_bin(mitmproxy_t)
miscfiles_read_localization(mitmproxy_t)
miscfiles_read_generic_certs(mitmproxy_t)
files_read_etc_files(mitmproxy_t)
files_search_var_lib(mitmproxy_t)
fs_search_cgroup_dirs(mitmproxy_t)
fs_read_cgroup_files(mitmproxy_t)
read_lnk_files_pattern(mitmproxy_t, mitmproxy_runtime_t, mitmproxy_runtime_t)
allow mitmproxy_t mitmproxy_runtime_t:file { execute map };
allow mitmproxy_t self:process getsched;
corenet_tcp_bind_generic_node(mitmproxy_t)
